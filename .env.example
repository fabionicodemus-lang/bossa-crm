# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público do CRM
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false

# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY_BASE64=

# Meta Lead Ads
META_LEAD_ADS_VERIFY_TOKEN=
META_LEAD_ADS_ACCESS_TOKEN=
META_LEAD_ADS_ORGANIZATION_ID=
FEATURE_DIRECT_WHATSAPP_CONNECTION=true
FEATURE_EMBEDDED_SIGNUP=false
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=

# IA de atendimento
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_FALLBACK=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_VERBOSITY=low
OPENAI_TIMEOUT_MS=25000

# Microsoft 365 / Outlook (somente variáveis do servidor, nunca NEXT_PUBLIC_)
# Criar aplicativo Web de organização no Microsoft Entra e permitir delegated
# User.Read + Calendars.ReadWrite + offline_access; URI de retorno deve coincidir exatamente.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Recomendado: GUID do tenant da Bossa; sem ele, organizações Microsoft (sem contas pessoais).
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://crm.bossaempreendimentos.com.br/api/microsoft/callback
# Chave exclusiva de 32 bytes em Base64 para AES-256-GCM. Não publicar no GitHub.
MICROSOFT_TOKEN_ENCRYPTION_KEY_BASE64=

# Workers de SLA, resgate e recuperação de webhooks
CRON_SECRET=
