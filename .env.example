# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público do CRM
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use true apenas para criar o primeiro administrador; depois prefira false e convites.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=true

# Meta / WhatsApp Cloud API + WhatsApp Business App em Coexistência
META_APP_ID=
META_APP_SECRET=
# Informe explicitamente a versão habilitada no aplicativo Meta, por exemplo v25.0.
META_GRAPH_VERSION=
# Crie um valor aleatório forte e use exatamente o mesmo no painel de Webhooks da Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Chave Base64 que represente exatamente 32 bytes; usada para criptografar os tokens dos canais.
WHATSAPP_TOKEN_ENCRYPTION_KEY_BASE64=

# Coexistência oficial: mantenha true para conectar números já usados no WhatsApp Business.
FEATURE_EMBEDDED_SIGNUP=true
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=

# Diagnóstico técnico API-only. Normalmente deve permanecer false.
FEATURE_DIRECT_WHATSAPP_CONNECTION=false

# IA de atendimento e classificação (OpenAI / ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_FALLBACK=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_VERBOSITY=low
OPENAI_TIMEOUT_MS=25000

# Workers de SLA, resgate e recuperação de webhooks.
# Use o mesmo valor no Vault do Supabase; nunca salve a chave real no GitHub.
CRON_SECRET=